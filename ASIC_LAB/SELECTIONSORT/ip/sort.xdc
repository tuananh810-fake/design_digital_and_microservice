# ZedBoard Pin Assignments
############################
# On-board Slide Switches  #
############################
set_property PACKAGE_PIN F22 [get_ports ext_addr[0]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[0]]
set_property PACKAGE_PIN G22 [get_ports ext_addr[1]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[1]]
set_property PACKAGE_PIN H22 [get_ports ext_addr[2]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[2]]
set_property PACKAGE_PIN F21 [get_ports ext_addr[3]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[3]]
set_property PACKAGE_PIN H19 [get_ports ext_addr[4]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[4]]
set_property PACKAGE_PIN H18 [get_ports ext_addr[5]]
set_property IOSTANDARD LVCMOS33 [get_ports ext_addr[5]]
set_property PACKAGE_PIN H17 [get_ports start_i]
set_property IOSTANDARD LVCMOS33 [get_ports start_i]
set_property PACKAGE_PIN M15 [get_ports rst]
set_property IOSTANDARD LVCMOS33 [get_ports rst]

set_property PACKAGE_PIN Y9 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
############################
# On-board led             #
############################
set_property PACKAGE_PIN T22 [get_ports rdata_out[0]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[0]]
set_property PACKAGE_PIN T21 [get_ports rdata_out[1]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[1]]
set_property PACKAGE_PIN U22 [get_ports rdata_out[2]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[2]]
set_property PACKAGE_PIN U21 [get_ports rdata_out[3]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[3]]
set_property PACKAGE_PIN V22 [get_ports rdata_out[4]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[4]]
set_property PACKAGE_PIN W22 [get_ports rdata_out[5]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[5]]
set_property PACKAGE_PIN U19 [get_ports rdata_out[6]]
set_property IOSTANDARD LVCMOS33 [get_ports rdata_out[6]]
set_property PACKAGE_PIN U14 [get_ports done_o]
set_property IOSTANDARD LVCMOS33 [get_ports done_o]
